<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

  <mapper namespace="com.example.expenses.repository.ExpenseMapper">

  <!--
    コンストラクタマッピング用 resultMap
    Expense ドメインオブジェクトは全フィールドが final のため、
    setter ではなくコンストラクタインジェクションを使用する
  -->
  <resultMap id="expenseResultMap" type="Expense">
    <constructor>
      <idArg column="id" javaType="Long"/>
      <arg column="applicant_id" javaType="Long"/>
      <arg column="title" javaType="String"/>
      <arg column="amount" javaType="BigDecimal"/>
      <arg column="currency" javaType="String"/>
      <arg column="status" javaType="ExpenseStatus"/>
      <arg column="submitted_at" javaType="java.time.LocalDateTime"/>
      <arg column="created_at" javaType="java.time.LocalDateTime"/>
      <arg column="updated_at" javaType="java.time.LocalDateTime"/>
      <arg column="version" javaType="int"/>
    </constructor>
  </resultMap>

  <!--
    【offset-limit ページング】UI 向け検索クエリ
    - LIMIT / OFFSET によるページング（ページ番号方式）
    - ページ数が増えると OFFSET の値が大きくなりパフォーマンスが低下する特性がある
    - 用途：画面の一覧表示（ページネーション付き）

    【ORDER BY の ${}（文字列補間）について】
    MyBatis の #{} はプリペアドステートメントのバインド変数になるため、
    カラム名や ASC/DESC の指定には使えない。
    そのため ORDER BY には ${} を使うが、SQL インジェクションのリスクがある。
    → ExpenseService#normalizedOrderBy() と #normalizedDirection() で
       ALLOWED_SORTS 許可リストに対する検証を行い、安全な値のみ渡している。
  -->
  <select id="search" resultMap="expenseResultMap">
  	SELECT
  		id,
  		applicant_id,
  		title,
  		amount,
  		currency,
  		status,
  		submitted_at,
  		created_at,
  		updated_at,
  		version
  	FROM expenses
  	<!--
  	  <where> タグ：囲んだ <if> が 1 つでも真になると WHERE を自動で付与し、
  	  先頭の AND / OR を取り除いてくれる。
  	  "WHERE 1=1" と書くより意図が明確で、余分な条件が残らない。
  	-->
  	<where>
  		<if test="criteria.applicantId != null">
  			AND applicant_id = #{criteria.applicantId}
  		</if>
  		<if test="criteria.title != null and criteria.title != ''">
  			AND title LIKE CONCAT('%', #{criteria.title}, '%')
  		</if>
  		<if test="criteria.amountMin != null">
  			AND amount <![CDATA[>=]]> #{criteria.amountMin}
  		</if>
  		<if test="criteria.amountMax != null">
  			AND amount <![CDATA[<=]]> #{criteria.amountMax}
  		</if>
  		<if test="criteria.status != null and criteria.status != ''">
  			AND status = #{criteria.status}
  		</if>
  		<if test="criteria.submittedFrom != null">
  			AND submitted_at <![CDATA[>=]]> #{criteria.submittedFrom}
  		</if>
  		<if test="criteria.submittedTo != null">
  			AND submitted_at <![CDATA[<=]]> #{criteria.submittedTo}
  		</if>
  	</where>
  	ORDER BY ${orderBy} ${direction}
  	LIMIT #{size} OFFSET #{offset}
  </select>

  <!--
    search と同じ条件でレコード数を取得する（ページ総数の計算に使用）
  -->
  <select id="count" resultType="long">
  	SELECT count(*)
  	FROM expenses
  	<where>
  		<if test="criteria.applicantId != null">
  			AND applicant_id = #{criteria.applicantId}
  		</if>
  		<if test="criteria.title != null and criteria.title != ''">
  			AND title LIKE CONCAT('%', #{criteria.title}, '%')
  		</if>
  		<if test="criteria.amountMin != null">
  			AND amount <![CDATA[>=]]> #{criteria.amountMin}
  		</if>
  		<if test="criteria.amountMax != null">
  			AND amount <![CDATA[<=]]> #{criteria.amountMax}
  		</if>
  		<if test="criteria.status != null and criteria.status != ''">
  			AND status = #{criteria.status}
  		</if>
  		<if test="criteria.submittedFrom != null">
  			AND submitted_at <![CDATA[>=]]> #{criteria.submittedFrom}
  		</if>
  		<if test="criteria.submittedTo != null">
  			AND submitted_at <![CDATA[<=]]> #{criteria.submittedTo}
  		</if>
  	</where>
  </select>

  <update id="approve">
  	UPDATE expenses
  	SET status = 'APPROVED',
  		updated_at = NOW(),
  		version = version + 1
  	WHERE id = #{id}
  		AND version = #{version}
  		AND status = 'SUBMITTED'
  </update>

  <update id="reject">
  	UPDATE expenses
  	SET status = "REJECTED",
  		updated_at = NOW(),
  		version = version + 1
  	WHERE id = #{id}
  		AND version = #{version}
  		AND status = 'SUBMITTED'
  </update>

  <!--
    CSV エクスポート向けフィルタ検索（ページネーションなし・全件取得）
    ExpenseExportService から呼び出される。

    <trim prefix="WHERE" prefixOverrides="AND |OR "> は
    <where> タグと同じ動作をする。<where> は <trim> のショートハンド。
  -->
  <select id="filter" resultMap="expenseResultMap">
  	SELECT
  		id,
  		applicant_id,
  		title,
  		amount,
  		currency,
  		status,
  		submitted_at,
  		created_at,
  		updated_at,
  		version
  	FROM expenses
  	<where>
  		<if test="criteria.status != null and criteria.status != ''">
  			AND status = #{criteria.status}
  		</if>
  		<if test="criteria.title != null and criteria.title != ''">
  			AND title LIKE CONCAT('%', #{criteria.title}, '%')
  		</if>
  		<if test="criteria.amountMin != null">
  			AND amount <![CDATA[>=]]> #{criteria.amountMin}
  		</if>
  		<if test="criteria.amountMax != null">
  			AND amount <![CDATA[<=]]> #{criteria.amountMax}
  		</if>
  		<if test="criteria.submittedFrom != null">
  			AND submitted_at <![CDATA[>=]]> #{criteria.submittedFrom}
  		</if>
  		<if test="criteria.submittedTo != null">
  			AND submitted_at <![CDATA[<=]]> #{criteria.submittedTo}
  		</if>
  	</where>
  	ORDER BY
  	<!--
  	  <choose> は Java の switch-case 相当。
  	  orderBy パラメータを文字列で受け取り、許可されたカラムだけを使う。
  	  こうすることで ${}（文字列補間）を使わずに動的 ORDER BY を安全に実現できる。
  	-->
  	<choose>
  		<when test="orderBy == 'title'">title</when>
  		<when test="orderBy == 'submitted_at'">submitted_at</when>
  		<when test="orderBy == 'updated_at'">updated_at</when>
  		<otherwise>created_at</otherwise>
  	</choose>
  	<if test="direction == 'ASC' or direction == 'DESC'">
  		${direction}
  	</if>
  </select>

  <!--
    【カーソルベース ページング（Spring Batch 用）】

    offset-limit 方式の問題点：
      OFFSET 10000 のような大きな値では、DB がスキップ対象行もスキャンするため遅い。

    カーソルベース（keyset pagination）の仕組み：
      前のページの最後の id を "カーソル" として保持し、
      WHERE id < #{maxId} で次のページを取得する。
      → 常にインデックスの先頭から読めるため大量データでも高速。

    PagingBatchConfiguration（Spring Batch）で MyBatisItemReader として使用。
    バッチが maxId を渡しながら順次フェッチする。
  -->
  <select id="findAllWithPaging" resultMap="expenseResultMap">
  	SELECT
  		id,
  		applicant_id,
  		title,
  		amount,
  		currency,
  		status,
  		submitted_at,
  		created_at,
  		updated_at,
  		version
  	FROM expenses
  	WHERE id <![CDATA[<]]> #{maxId}
  	ORDER BY id ASC
  </select>

  <!--
    【ID 範囲指定による並列バッチ読み込み】

    ParallelBatchConfiguration（Spring Batch）で使用。
    データを ID 範囲で分割し、複数ステップが並列で読み込む。
    例：ステップ1が id 1〜1000、ステップ2が id 1001〜2000 を処理する。

    findAllWithPaging（前方スキャン）との使い分け：
      - findAllWithPaging：順次処理、フルスキャン向け
      - findByIdRange：並列処理、範囲分割向け
  -->
  <select id="findByIdRange" resultMap="expenseResultMap">
  	SELECT
  		id,
  		applicant_id,
  		title,
  		amount,
  		currency,
  		status,
  		submitted_at,
  		created_at,
  		updated_at,
  		version
  	FROM expenses
  	WHERE id BETWEEN #{minId} AND #{maxId}
  	ORDER BY id ASC
  </select>

  </mapper>
